<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Encoding" content="IE=edge" />
    <title>Welcome to PH Healthcare System</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; -webkit-font-smoothing: antialiased; color: #1e293b;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f1f5f9; padding: 40px 16px;">
      <tr>
        <td align="center">
          <!-- Main Container -->
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 540px; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04); border: 1px solid #e2e8f0;">
            
            <!-- Hero Header with Emerald Teal Gradient -->
            <tr>
              <td style="background: linear-gradient(135deg, #0d9488 0%, #0284c7 100%); background-color: #0d9488; padding: 40px 32px 32px 32px; text-align: center;">
                <!-- Icon Badge -->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center" style="margin: 0 auto 16px auto;">
                  <tr>
                    <td style="background-color: rgba(255, 255, 255, 0.2); width: 64px; height: 64px; border-radius: 50%; text-align: center; vertical-align: middle; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);">
                      <span style="font-size: 30px; line-height: 64px;">🎉</span>
                    </td>
                  </tr>
                </table>
                
                <!-- App Title -->
                <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: rgba(255, 255, 255, 0.9);">
                  PH HEALTHCARE SYSTEM
                </p>
                
                <h1 style="margin: 0; font-size: 24px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px;">
                  Welcome Aboard!
                </h1>
              </td>
            </tr>

            <!-- Email Body Content -->
            <tr>
              <td style="padding: 36px 32px 28px 32px;">
                <p style="margin: 0 0 12px 0; font-size: 18px; font-weight: 700; color: #0f172a;">
                  Dear <%= typeof name !== 'undefined' && name ? name : 'Patient' %>,
                </p>
                <p style="margin: 0 0 20px 0; font-size: 15px; line-height: 1.6; color: #475569;">
                  Your email has been verified successfully, and your account is now active! We are thrilled to welcome you to <strong>PH Healthcare System</strong>.
                </p>

                <!-- Features Card -->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin: 0 0 24px 0;">
                  <tr>
                    <td>
                      <p style="margin: 0 0 12px 0; font-size: 14px; font-weight: 700; color: #0f172a; text-transform: uppercase; letter-spacing: 0.5px;">
                        What you can do with your account:
                      </p>
                      
                      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                        <tr>
                          <td style="padding: 6px 0; font-size: 14px; color: #334155; line-height: 1.5;">
                            🩺 <strong>Find Doctors:</strong> Search experienced specialists for your health needs.
                          </td>
                        </tr>
                        <tr>
                          <td style="padding: 6px 0; font-size: 14px; color: #334155; line-height: 1.5;">
                            📅 <strong>Book Appointments:</strong> Schedule consultations seamlessly online.
                          </td>
                        </tr>
                        <tr>
                          <td style="padding: 6px 0; font-size: 14px; color: #334155; line-height: 1.5;">
                            📋 <strong>Health Records:</strong> Access and manage your medical records safely.
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>

                <p style="margin: 0 0 24px 0; font-size: 15px; line-height: 1.6; color: #475569;">
                  If you have any questions or need help setting up your profile, our support team is always here to assist you.
                </p>
                
                <!-- Notice Box -->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f0fdf4; border-left: 4px solid #0d9488; border-radius: 4px 8px 8px 4px; padding: 14px 16px;">
                  <tr>
                    <td style="font-size: 13px; line-height: 1.5; color: #166534;">
                      <strong style="color: #15803d;">Tip:</strong> Keep your profile and contact details up to date to ensure seamless appointment notifications.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 0 32px;">
                <div style="border-top: 1px solid #e2e8f0; height: 1px; width: 100%;"></div>
              </td>
            </tr>

            <!-- Footer Section -->
            <tr>
              <td style="padding: 24px 32px 32px 32px; text-align: center;">
                <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 600; color: #64748b;">
                  Need assistance? Contact our support team anytime.
                </p>
                <p style="margin: 0; font-size: 12px; color: #94a3b8;">
                  &copy; <%= new Date().getFullYear() %> PH Healthcare System. All rights reserved.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>