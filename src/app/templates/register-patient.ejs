<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Encoding" content="IE=edge" />
    <title>Verify Your Email - PH Healthcare System</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; -webkit-font-smoothing: antialiased; color: #1e293b;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f1f5f9; padding: 40px 16px;">
      <tr>
        <td align="center">
          <!-- Main Container -->
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 520px; background-color: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04); border: 1px solid #e2e8f0;">
            
            <!-- Hero Header with Emerald Teal Gradient -->
            <tr>
              <td style="background: linear-gradient(135deg, #0d9488 0%, #0284c7 100%); background-color: #0d9488; padding: 40px 32px 32px 32px; text-align: center;">
                <!-- Icon Badge -->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center" style="margin: 0 auto 16px auto;">
                  <tr>
                    <td style="background-color: rgba(255, 255, 255, 0.2); width: 64px; height: 64px; border-radius: 50%; text-align: center; vertical-align: middle; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);">
                      <span style="font-size: 30px; line-height: 64px;">🩺</span>
                    </td>
                  </tr>
                </table>
                
                <!-- App Title -->
                <p style="margin: 0 0 6px 0; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: rgba(255, 255, 255, 0.9);">
                  PH HEALTHCARE SYSTEM
                </p>
                
                <h1 style="margin: 0; font-size: 24px; font-weight: 800; color: #ffffff; letter-spacing: -0.5px;">
                  Welcome! Verify Your Email
                </h1>
              </td>
            </tr>

            <!-- Email Body Content -->
            <tr>
              <td style="padding: 36px 32px 28px 32px;">
                <p style="margin: 0 0 12px 0; font-size: 16px; font-weight: 600; color: #0f172a;">
                  Hello <%= typeof name !== 'undefined' && name ? name : 'Patient' %> 👋
                </p>
                <p style="margin: 0 0 24px 0; font-size: 15px; line-height: 1.6; color: #475569;">
                  Thank you for joining PH Healthcare System! To complete your registration and activate your patient account, please enter the 6-digit verification code below:
                </p>
                
                <!-- OTP Box -->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 0 0 24px 0;">
                  <tr>
                    <td style="background-color: #f0fdf4; border: 2px dashed #86efac; border-radius: 12px; padding: 20px; text-align: center;">
                      <p style="margin: 0 0 6px 0; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #15803d;">
                        YOUR REGISTRATION CODE
                      </p>
                      <div style="font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Courier New', Courier, monospace; font-size: 36px; font-weight: 800; letter-spacing: 12px; color: #166534; padding-left: 12px;">
                        <%= otp %>
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Expiration Notice Pill -->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" align="center" style="margin: 0 auto 28px auto;">
                  <tr>
                    <td style="background-color: #fef3c7; border: 1px solid #fde68a; border-radius: 20px; padding: 6px 16px; text-align: center;">
                      <span style="font-size: 13px; font-weight: 600; color: #92400e;">
                        ⏱️ Code expires in <strong>5 minutes</strong>
                      </span>
                    </td>
                  </tr>
                </table>

                <!-- Security Alert Note Box -->
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border-left: 4px solid #0d9488; border-radius: 4px 8px 8px 4px; padding: 14px 16px;">
                  <tr>
                    <td style="font-size: 13px; line-height: 1.5; color: #64748b;">
                      <strong style="color: #334155;">Security Notice:</strong> If you did not sign up for a PH Healthcare System account, please disregard this email.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding: 0 32px;">
                <div style="border-top: 1px solid #e2e8f0; height: 1px; width: 100%;"></div>
              </td>
            </tr>

            <!-- Footer Section -->
            <tr>
              <td style="padding: 24px 32px 32px 32px; text-align: center;">
                <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 600; color: #64748b;">
                  Need assistance? Contact our support team.
                </p>
                <p style="margin: 0; font-size: 12px; color: #94a3b8;">
                  &copy; <%= new Date().getFullYear() %> PH Healthcare System. All rights reserved.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>